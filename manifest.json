{
  "manifest_version": 3,
  "name": "DashMap",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon128.png",
    "default_title": "DashMap"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["*://dashcraft.io/*", "*://*.dashcraft.io/*"],
  "content_scripts": [
    {
      "matches": ["*://dashcraft.io/*"],
      "js": ["injector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://dashcraft.io/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injector.js"],
      "matches": ["*://dashcraft.io/*", "*://*.dashcraft.io/*"]
    }
  ]
}